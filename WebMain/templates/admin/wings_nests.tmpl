{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin wings-nests")}}

<div class="ui container">
	<h4 class="ui top attached header">{{ctx.Locale.Tr "admin.wings_nests"}}</h4>
	<div class="ui attached segment">
		<p>{{ctx.Locale.Tr "admin.wings_nests.description"}}</p>

		<h5 class="ui header">{{ctx.Locale.Tr "admin.wings_nests.create_nest"}}</h5>
		<form class="ui form" method="post" action="{{AppSubUrl}}/admin/wings/nests">
			<div class="required field">
				<label for="wings-nest-name">{{ctx.Locale.Tr "admin.wings_nests.name"}}</label>
				<input id="wings-nest-name" name="name" maxlength="191" required>
			</div>
			<div class="field">
				<label for="wings-nest-description">{{ctx.Locale.Tr "admin.wings_nests.description"}}</label>
				<input id="wings-nest-description" name="description" maxlength="1000">
			</div>
			<button class="ui primary button" type="submit">{{ctx.Locale.Tr "admin.wings_nests.create"}}</button>
		</form>

		<h5 class="ui header">{{ctx.Locale.Tr "admin.wings_nests.saved_nests"}}</h5>
		{{if .Nests}}
		<table class="ui celled table">
			<thead>
				<tr>
					<th>{{ctx.Locale.Tr "admin.wings_nests.name"}}</th>
					<th>{{ctx.Locale.Tr "admin.wings_nests.actions"}}</th>
				</tr>
			</thead>
			<tbody>
				{{range .Nests}}
				<tr>
					<td>{{.Name}}</td>
					<td>
						<form method="post" action="{{AppSubUrl}}/admin/wings/nests/{{.ID}}/delete" style="display:inline">
							<button class="ui red button" type="submit">{{ctx.Locale.Tr "admin.wings_nests.delete"}}</button>
						</form>
					</td>
				</tr>
				{{end}}
			</tbody>
		</table>
		{{else}}
		<p>{{ctx.Locale.Tr "admin.wings_nests.empty"}}</p>
		{{end}}

		<h5 class="ui header">{{ctx.Locale.Tr "admin.wings_nests.create_egg"}}</h5>
		<form class="ui form" method="post" action="{{AppSubUrl}}/admin/wings/nests/eggs">
			<div class="required field">
				<label for="wings-egg-nest">{{ctx.Locale.Tr "admin.wings_nests.nest"}}</label>
				<select id="wings-egg-nest" name="nest_id" required>
					{{range .Nests}}
					<option value="{{.ID}}">{{.Name}}</option>
					{{end}}
				</select>
			</div>
			<div class="required field">
				<label for="wings-egg-name">{{ctx.Locale.Tr "admin.wings_nests.name"}}</label>
				<input id="wings-egg-name" name="name" maxlength="191" required>
			</div>
			<div class="field">
				<label for="wings-egg-description">{{ctx.Locale.Tr "admin.wings_nests.description"}}</label>
				<input id="wings-egg-description" name="description" maxlength="1000">
			</div>
			<div class="field">
				<label for="wings-egg-image">{{ctx.Locale.Tr "admin.wings_nests.docker_image"}}</label>
				<input id="wings-egg-image" name="docker_image" maxlength="255" placeholder="ghcr.io/pterodactyl/yolks:nodejs_20">
			</div>
			<div class="field">
				<label for="wings-egg-startup">{{ctx.Locale.Tr "admin.wings_nests.startup"}}</label>
				<input id="wings-egg-startup" name="startup" maxlength="1000" placeholder="npm start">
			</div>
			<button class="ui primary button" type="submit">{{ctx.Locale.Tr "admin.wings_nests.create"}}</button>
		</form>

		<h5 class="ui header">{{ctx.Locale.Tr "admin.wings_nests.import_egg"}}</h5>
		<form class="ui form" method="post" action="{{AppSubUrl}}/admin/wings/nests/eggs/import">
			<div class="required field">
				<label for="wings-import-nest">{{ctx.Locale.Tr "admin.wings_nests.nest"}}</label>
				<select id="wings-import-nest" name="nest_id" required>
					{{range .Nests}}
					<option value="{{.ID}}">{{.Name}}</option>
					{{end}}
				</select>
			</div>
			<div class="required field">
				<label for="wings-import-json">{{ctx.Locale.Tr "admin.wings_nests.import_egg"}}</label>
				<textarea id="wings-import-json" name="egg_json" rows="10" required placeholder='{"name":"...","docker_image":"...","startup":"...","variables":[...]}'></textarea>
			</div>
			<button class="ui primary button" type="submit">{{ctx.Locale.Tr "admin.wings_nests.import"}}</button>
		</form>

		<h5 class="ui header">{{ctx.Locale.Tr "admin.wings_nests.saved_eggs"}}</h5>
		{{if .Eggs}}
		<table class="ui celled table">
			<thead>
				<tr>
					<th>{{ctx.Locale.Tr "admin.wings_nests.nest"}}</th>
					<th>{{ctx.Locale.Tr "admin.wings_nests.name"}}</th>
					<th>{{ctx.Locale.Tr "admin.wings_nests.docker_image"}}</th>
					<th>{{ctx.Locale.Tr "admin.wings_nests.actions"}}</th>
				</tr>
			</thead>
			<tbody>
				{{range .Eggs}}
				<tr>
					<td>{{.NestID}}</td>
					<td>{{.Name}}</td>
					<td>{{.DockerImage}}</td>
					<td>
						<form method="post" action="{{AppSubUrl}}/admin/wings/nests/eggs/{{.ID}}/delete" style="display:inline">
							<button class="ui red button" type="submit">{{ctx.Locale.Tr "admin.wings_nests.delete"}}</button>
						</form>
					</td>
				</tr>
				{{end}}
			</tbody>
		</table>
		{{else}}
		<p>{{ctx.Locale.Tr "admin.wings_nests.empty"}}</p>
		{{end}}

		<h5 class="ui header">{{ctx.Locale.Tr "admin.wings_nests.create_variable"}}</h5>
		<form class="ui form" method="post" action="{{AppSubUrl}}/admin/wings/nests/eggs/variables">
			<div class="required field">
				<label for="wings-variable-egg">{{ctx.Locale.Tr "admin.wings_nests.egg"}}</label>
				<select id="wings-variable-egg" name="egg_id" required>
					{{range .Eggs}}
					<option value="{{.ID}}">{{.Name}}</option>
					{{end}}
				</select>
			</div>
			<div class="required field">
				<label for="wings-variable-name">{{ctx.Locale.Tr "admin.wings_nests.name"}}</label>
				<input id="wings-variable-name" name="name" maxlength="191" required>
			</div>
			<div class="required field">
				<label for="wings-variable-env">{{ctx.Locale.Tr "admin.wings_nests.env_variable"}}</label>
				<input id="wings-variable-env" name="env_variable" maxlength="191" required>
			</div>
			<div class="field">
				<label for="wings-variable-default">{{ctx.Locale.Tr "admin.wings_nests.default_value"}}</label>
				<input id="wings-variable-default" name="default_value">
			</div>
			<div class="field">
				<label for="wings-variable-rules">{{ctx.Locale.Tr "admin.wings_nests.rules"}}</label>
				<input id="wings-variable-rules" name="rules" placeholder="required|string|max:255">
			</div>
			<div class="field">
				<div class="ui checkbox">
					<input type="checkbox" name="user_viewable" value="true" checked>
					<label>{{ctx.Locale.Tr "admin.wings_nests.user_viewable"}}</label>
				</div>
			</div>
			<div class="field">
				<div class="ui checkbox">
					<input type="checkbox" name="user_editable" value="true" checked>
					<label>{{ctx.Locale.Tr "admin.wings_nests.user_editable"}}</label>
				</div>
			</div>
			<button class="ui primary button" type="submit">{{ctx.Locale.Tr "admin.wings_nests.create"}}</button>
		</form>

		<h5 class="ui header">{{ctx.Locale.Tr "admin.wings_nests.saved_variables"}}</h5>
		{{range .Eggs}}
		{{if (index $.Variables .ID)}}
		<p><strong>{{.Name}}</strong></p>
		<table class="ui celled table">
			<thead>
				<tr>
					<th>{{ctx.Locale.Tr "admin.wings_nests.name"}}</th>
					<th>{{ctx.Locale.Tr "admin.wings_nests.env_variable"}}</th>
					<th>{{ctx.Locale.Tr "admin.wings_nests.default_value"}}</th>
					<th>{{ctx.Locale.Tr "admin.wings_nests.actions"}}</th>
				</tr>
			</thead>
			<tbody>
				{{range (index $.Variables .ID)}}
				<tr>
					<td>{{.Name}}</td>
					<td>{{.EnvVariable}}</td>
					<td>{{.DefaultValue}}</td>
					<td>
						<form method="post" action="{{AppSubUrl}}/admin/wings/nests/eggs/variables/{{.ID}}/delete" style="display:inline">
							<button class="ui red button" type="submit">{{ctx.Locale.Tr "admin.wings_nests.delete"}}</button>
						</form>
					</td>
				</tr>
				{{end}}
			</tbody>
		</table>
		{{end}}
		{{end}}
	</div>
</div>
{{template "admin/layout_footer" .}}