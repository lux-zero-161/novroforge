{{template "base/head" .}}
<div role="main" aria-label="{{.Server.Name}}" class="page-content">
	<div class="ui container">
		<h1 class="ui header">{{.Server.Name}}</h1>
		<p><a href="{{AppSubUrl}}/user/servers">{{ctx.Locale.Tr "wings.back_to_servers"}}</a></p>
		<div class="ui segment">
			<p>{{ctx.Locale.Tr "wings.server_state"}}: <strong id="wings-server-state">{{.Details.State}}</strong></p>
			<p>{{ctx.Locale.Tr "wings.server_suspended"}}: <span id="wings-server-suspended">{{if .Details.IsSuspended}}{{ctx.Locale.Tr "wings.suspended"}}{{else}}{{ctx.Locale.Tr "wings.not_suspended"}}{{end}}</span></p>
			<p>{{ctx.Locale.Tr "wings.server_cpu"}}: <span id="wings-server-cpu">{{.Details.Utilization.CPUAbsolute}}</span> %</p>
			<p>{{ctx.Locale.Tr "wings.server_memory"}}: <span id="wings-server-memory">{{.Details.Utilization.MemoryBytes}} / {{.Details.Utilization.MemoryLimit}}</span></p>
			<p>{{ctx.Locale.Tr "wings.server_disk"}}: <span id="wings-server-disk">{{.Details.Utilization.DiskBytes}}</span></p>
			<p>{{ctx.Locale.Tr "wings.server_uptime"}}: <span id="wings-server-uptime">{{.Details.Utilization.Uptime}}</span> {{ctx.Locale.Tr "wings.seconds"}}</p>
			<p>{{ctx.Locale.Tr "wings.server_network"}}: {{ctx.Locale.Tr "wings.server_network_rx"}} <span id="wings-server-network-rx">{{.Details.Utilization.Network.RxBytes}}</span>, {{ctx.Locale.Tr "wings.server_network_tx"}} <span id="wings-server-network-tx">{{.Details.Utilization.Network.TxBytes}}</span></p>
		</div>
		{{if .Access.CanPower}}
			<form class="ui form" method="post" action="{{AppSubUrl}}/user/servers/{{.Server.ID}}/power" data-wings-power-form>
				<label for="wings-user-power">{{ctx.Locale.Tr "wings.power_action"}}</label>
				<select id="wings-user-power" name="action" data-wings-power-action>
					<option value="start">{{ctx.Locale.Tr "wings.start"}}</option>
					<option value="stop">{{ctx.Locale.Tr "wings.stop"}}</option>
					<option value="restart">{{ctx.Locale.Tr "wings.restart"}}</option>
					<option value="kill">{{ctx.Locale.Tr "wings.kill"}}</option>
				</select>
				<div class="field" data-wings-kill-confirmation hidden>
					<div class="ui checkbox">
						<input type="checkbox" name="confirm_kill" value="true" required>
						<label>{{ctx.Locale.Tr "wings.power_kill_confirm"}}</label>
					</div>
				</div>
				<button class="ui primary button" type="submit">{{ctx.Locale.Tr "wings.send_action"}}</button>
			</form>
		{{end}}
		{{if or .Access.CanFiles .Access.CanReadFiles .Access.CanDownloadFiles .Access.CanManageFiles .Access.CanEditFiles .Access.CanDeleteFiles .Access.CanUploadFiles}}
			<p><a class="ui button" href="{{AppSubUrl}}/user/servers/{{.Server.ID}}/files">{{ctx.Locale.Tr "wings.files"}}</a></p>
		{{end}}
		{{if or .Access.CanBackups .Access.CanDownloadBackups}}
			<p><a class="ui button" href="{{AppSubUrl}}/user/servers/{{.Server.ID}}/backups">{{ctx.Locale.Tr "wings.backups"}}</a></p>
		{{end}}
		<h2 class="ui header">{{ctx.Locale.Tr "wings.console"}}</h2>
		<div
			id="wings-console"
			data-logs-url="{{AppSubUrl}}/user/servers/{{.Server.ID}}/logs"
			data-websocket-url="{{AppSubUrl}}/user/servers/{{.Server.ID}}/console/ws"
			data-loading="{{ctx.Locale.Tr "wings.logs_loading"}}"
			data-error="{{ctx.Locale.Tr "wings.server_update_unavailable"}}"
			data-empty="{{ctx.Locale.Tr "wings.no_logs"}}"
			data-updated="{{ctx.Locale.Tr "wings.logs_updated"}}"
			data-live="{{ctx.Locale.Tr "wings.logs_live"}}"
			data-reconnecting="{{ctx.Locale.Tr "wings.logs_reconnecting"}}"
			data-suspended="{{ctx.Locale.Tr "wings.suspended"}}"
			data-not-suspended="{{ctx.Locale.Tr "wings.not_suspended"}}"
			aria-live="polite"
		>
			<pre class="code-block" id="wings-console-output">{{if .Logs}}{{range .Logs}}{{.}}{{"\n"}}{{end}}{{else}}{{ctx.Locale.Tr "wings.no_logs"}}{{end}}</pre>
			<p id="wings-console-status" class="muted">{{ctx.Locale.Tr "wings.logs_loading"}}</p>
		</div>
		{{if .Access.CanConsole}}
			<form class="ui form" method="post" action="{{AppSubUrl}}/user/servers/{{.Server.ID}}/command">
				<div class="required field">
					<label for="wings-user-command">{{ctx.Locale.Tr "wings.command"}}</label>
					<input id="wings-user-command" name="command" maxlength="4096" required>
				</div>
				<button class="ui button" type="submit">{{ctx.Locale.Tr "wings.send_command"}}</button>
			</form>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
