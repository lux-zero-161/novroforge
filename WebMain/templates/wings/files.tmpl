{{template "base/head" .}}
<div role="main" aria-label="{{ctx.Locale.Tr "wings.files"}}" class="page-content">
	<div class="ui container">
		<h1 class="ui header">{{ctx.Locale.Tr "wings.files"}}: {{.Server.Name}}</h1>
		<p><a href="{{AppSubUrl}}/user/servers/{{.Server.ID}}">{{ctx.Locale.Tr "wings.back_to_server"}}</a></p>
		<p>{{ctx.Locale.Tr "wings.directory"}}: <code>{{.Directory}}</code></p>
		<p>
			<a class="ui button" href="{{AppSubUrl}}/user/servers/{{.Server.ID}}/files?directory={{.RootDirectory}}">{{ctx.Locale.Tr "wings.root_directory"}}</a>
			{{if .HasParentDirectory}}
				<a class="ui button" href="{{AppSubUrl}}/user/servers/{{.Server.ID}}/files?directory={{.ParentDirectory}}">{{ctx.Locale.Tr "wings.parent_directory"}}</a>
			{{end}}
		</p>
		{{if .CanManageFiles}}
			<form class="ui form" method="post" action="{{AppSubUrl}}/user/servers/{{.Server.ID}}/files/directory">
				<input type="hidden" name="directory" value="{{.Directory}}">
				<div class="inline fields">
					<div class="field">
						<label for="wings-new-directory">{{ctx.Locale.Tr "wings.new_directory_name"}}</label>
						<input id="wings-new-directory" name="name" maxlength="255" required>
					</div>
					<div class="field">
						<button class="ui button" type="submit">{{ctx.Locale.Tr "wings.create_directory"}}</button>
					</div>
				</div>
			</form>
		{{end}}
		{{if .CanUploadFiles}}
			<div class="ui segment">
				<p>{{ctx.Locale.Tr "wings.file_upload_help"}}</p>
				<form class="ui form" method="post" enctype="multipart/form-data" action="{{AppSubUrl}}/user/servers/{{.Server.ID}}/files/upload">
					<input type="hidden" name="directory" value="{{.Directory}}">
					<div class="inline fields">
						<div class="field">
							<label for="wings-file-upload">{{ctx.Locale.Tr "wings.upload_file"}}</label>
							<input id="wings-file-upload" type="file" name="file" required>
						</div>
						<div class="field">
							<button class="ui button" type="submit">{{ctx.Locale.Tr "wings.upload_file"}}</button>
						</div>
					</div>
				</form>
			</div>
		{{end}}
		{{if .Files}}
			<div class="ui form">
				<div class="field">
					<label for="wings-file-filter">{{ctx.Locale.Tr "wings.file_filter"}}</label>
					<input id="wings-file-filter" type="search" data-wings-file-filter autocomplete="off">
				</div>
			</div>
			<div class="overflow menu">
				<table class="ui very basic striped table">
					<thead>
						<tr>
							<th>{{ctx.Locale.Tr "wings.file_name"}}</th>
							<th>{{ctx.Locale.Tr "wings.file_type"}}</th>
							<th>{{ctx.Locale.Tr "wings.file_size"}}</th>
							<th>{{ctx.Locale.Tr "wings.file_modified"}}</th>
							<th>{{ctx.Locale.Tr "wings.file_mode"}}</th>
							{{if .CanDownloadFiles}}<th>{{ctx.Locale.Tr "wings.file_download"}}</th>{{end}}
							{{if or .CanManageFiles .CanEditFiles .CanDeleteFiles}}<th>{{ctx.Locale.Tr "wings.file_actions"}}</th>{{end}}
						</tr>
					</thead>
					<tbody>
						{{range .Files}}
							<tr data-wings-file-row>
								<td>
									{{if and .Directory (not .Symlink)}}
										<a href="{{AppSubUrl}}/user/servers/{{$.Server.ID}}/files?directory={{.Path}}">{{.Name}}</a>
									{{else if and $.CanReadFiles .File (not .Symlink)}}
										<a href="{{AppSubUrl}}/user/servers/{{$.Server.ID}}/files/preview?file={{.PreviewPath}}">{{.Name}}</a>
									{{else}}
										{{.Name}}
									{{end}}
								</td>
								<td>{{if .Directory}}{{ctx.Locale.Tr "wings.directory"}}{{else}}{{.Mime}}{{end}}{{if .Symlink}} ({{ctx.Locale.Tr "wings.symlink"}}){{end}}</td>
								<td>{{.Size}}</td>
								<td>{{.Modified}}</td>
								<td><code>{{.ModeBits}}</code></td>
								{{if $.CanDownloadFiles}}
									<td>{{if .DownloadPath}}<a class="ui button" href="{{AppSubUrl}}/user/servers/{{$.Server.ID}}/files/download?file={{.DownloadPath}}">{{ctx.Locale.Tr "wings.file_download"}}</a>{{end}}</td>
								{{end}}
								{{if or $.CanManageFiles $.CanEditFiles $.CanDeleteFiles}}
									<td>
										{{if .EditPath}}
											<a class="ui button" href="{{AppSubUrl}}/user/servers/{{$.Server.ID}}/files/edit?file={{.EditPath}}">{{ctx.Locale.Tr "wings.edit_file"}}</a>
										{{end}}
										{{if and (not .Symlink) (or .File .Directory)}}
											{{if $.CanManageFiles}}
												<form class="ui form" method="post" action="{{AppSubUrl}}/user/servers/{{$.Server.ID}}/files/rename">
													<input type="hidden" name="directory" value="{{$.Directory}}">
													<input type="hidden" name="from" value="{{.Name}}">
													<div class="inline fields">
														<div class="field">
															<input name="to" value="{{.Name}}" maxlength="255" required aria-label="{{ctx.Locale.Tr "wings.new_file_name"}}">
														</div>
														<div class="field">
															<button class="ui button" type="submit">{{ctx.Locale.Tr "wings.rename_file"}}</button>
														</div>
													</div>
												</form>
											{{end}}
										{{end}}
										{{if and $.CanDeleteFiles .DeletePath}}
											<form class="ui form" method="post" action="{{AppSubUrl}}/user/servers/{{$.Server.ID}}/files/delete">
												<input type="hidden" name="file" value="{{.DeletePath}}">
												<div class="inline fields">
													<div class="field">
														<div class="ui checkbox">
															<input type="checkbox" name="confirm_delete" value="true" required>
															<label>{{ctx.Locale.Tr "wings.file_delete_confirm"}}</label>
														</div>
													</div>
													<div class="field">
														<button class="ui red button" type="submit">{{ctx.Locale.Tr "wings.delete_file"}}</button>
													</div>
												</div>
											</form>
										{{end}}
										{{if .CopyPath}}
											<form class="ui form" method="post" action="{{AppSubUrl}}/user/servers/{{$.Server.ID}}/files/copy">
												<input type="hidden" name="file" value="{{.CopyPath}}">
												<button class="ui button" type="submit">{{ctx.Locale.Tr "wings.copy_file"}}</button>
											</form>
										{{end}}
										{{if .CompressPath}}
											<form class="ui form" method="post" action="{{AppSubUrl}}/user/servers/{{$.Server.ID}}/files/compress">
												<input type="hidden" name="file" value="{{.CompressPath}}">
												<button class="ui button" type="submit">{{ctx.Locale.Tr "wings.compress_file"}}</button>
											</form>
										{{end}}
										{{if .CopyPath}}
											<form class="ui form" method="post" action="{{AppSubUrl}}/user/servers/{{$.Server.ID}}/files/decompress">
												<input type="hidden" name="file" value="{{.CopyPath}}">
												<div class="inline fields">
													<div class="field">
														<div class="ui checkbox">
															<input type="checkbox" name="confirm_decompress" value="true" required>
															<label>{{ctx.Locale.Tr "wings.file_decompress_confirm"}}</label>
														</div>
													</div>
													<div class="field">
														<button class="ui button" type="submit">{{ctx.Locale.Tr "wings.decompress_file"}}</button>
													</div>
												</div>
											</form>
											<form class="ui form" method="post" action="{{AppSubUrl}}/user/servers/{{$.Server.ID}}/files/chmod">
												<input type="hidden" name="file" value="{{.CopyPath}}">
												<div class="inline fields">
													<div class="field">
														<label>{{ctx.Locale.Tr "wings.file_mode"}}</label>
														<input name="mode" value="{{.ModeBits}}" inputmode="numeric" pattern="[0-7]{3,4}" maxlength="4" required aria-label="{{ctx.Locale.Tr "wings.file_mode"}}">
													</div>
													<div class="field">
														<div class="ui checkbox">
															<input type="checkbox" name="confirm_mode_change" value="true" required>
															<label>{{ctx.Locale.Tr "wings.file_mode_confirm"}}</label>
														</div>
													</div>
													<div class="field">
														<button class="ui button" type="submit">{{ctx.Locale.Tr "wings.update_file_mode"}}</button>
													</div>
												</div>
											</form>
										{{end}}
									</td>
								{{end}}
							</tr>
						{{end}}
					</tbody>
				</table>
			</div>
			<p class="ui message" data-wings-file-filter-empty hidden>{{ctx.Locale.Tr "wings.file_filter_no_results"}}</p>
		{{else}}
			<div class="ui message">{{ctx.Locale.Tr "wings.no_files"}}</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
