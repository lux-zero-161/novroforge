{{template "base/head" .}}
{{$user := .ContextUser}}
{{$isOrg := $user.IsOrganization}}
{{$base := AppSubUrl}}
{{if $isOrg}}{{$base = $user.OrganisationLink}}{{end}}
{{$teamPath := ""}}{{if .Team}}{{$teamPath = print "/" (PathEscape .Team.Name)}}{{end}}
{{$displayName := $user.Name}}{{if $user.DisplayName}}{{$displayName = $user.DisplayName}}{{end}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard feeds theme-sidebar-layout github-home" data-theme-sidebar="dashboard_sidebar_collapsed">
	<aside class="theme-sidebar github-home-sidebar" aria-label="{{ctx.Locale.Tr "dashboard"}}">
		<div class="theme-sidebar-content">
			<a class="github-home-logo" href="{{AppSubUrl}}/" aria-label="{{ctx.Locale.Tr "home"}}">{{svg "octicon-mark-github" 32}}</a>
			<nav class="github-home-nav" aria-label="{{ctx.Locale.Tr "dashboard"}}">
				<a class="active" href="{{if $isOrg}}{{$user.DashboardLink}}{{$teamPath}}{{else}}{{AppSubUrl}}/{{end}}">{{svg "octicon-home" 16}}<span>{{ctx.Locale.Tr "home"}}</span></a>
				{{if not .UnitIssuesGlobalDisabled}}<a href="{{$base}}/issues{{$teamPath}}">{{svg "octicon-issue-opened" 16}}<span>{{ctx.Locale.Tr "issues"}}</span></a>{{end}}
				{{if not .UnitPullsGlobalDisabled}}<a href="{{$base}}/pulls{{$teamPath}}">{{svg "octicon-git-pull-request" 16}}<span>{{ctx.Locale.Tr "pull_requests"}}</span></a>{{end}}
				{{if .ShowMilestonesDashboardPage}}<a href="{{$base}}/milestones{{$teamPath}}">{{svg "octicon-milestone" 16}}<span>{{ctx.Locale.Tr "milestones"}}</span></a>{{end}}
				<a href="{{$user.HomeLink}}/-/projects">{{svg "octicon-table" 16}}<span>Projects</span></a>
				<a href="{{$user.HomeLink}}?tab=repositories">{{svg "octicon-repo" 16}}<span>Repositories</span></a>
				<a href="{{$user.HomeLink}}?tab=stars">{{svg "octicon-star" 16}}<span>Stars</span></a>
				<a href="{{AppSubUrl}}/explore/repos">{{svg "octicon-telescope" 16}}<span>Explore</span></a>
			</nav>
			<section class="github-home-pinned" aria-labelledby="github-home-pinned-title">
				<h2 id="github-home-pinned-title">Pinned repositories</h2>
				{{range .DashboardPinnedRepos}}
					<a class="github-home-pinned-repo" href="{{.Link}}">
						{{svg "octicon-repo" 16}}
						<span class="github-home-pinned-name">{{.OwnerName}}/{{.Name}}</span>
						<span class="github-home-pinned-meta">
							{{if .PrimaryLanguage}}<i class="color-icon" style="background-color: {{.PrimaryLanguage.Color}}"></i>{{.PrimaryLanguage.Language}}{{end}}
							{{if .NumStars}}<span>{{svg "octicon-star" 12}}{{CountFmt .NumStars}}</span>{{end}}
						</span>
					</a>
				{{else}}
					<p class="github-home-sidebar-empty">No repositories yet.</p>
				{{end}}
				<a class="github-home-sidebar-link" href="{{$user.HomeLink}}?tab=repositories">Show more</a>
			</section>
		</div>
		<div class="github-home-sidebar-footer">
			<a class="github-home-profile" href="{{$user.HomeLink}}">
				{{ctx.AvatarUtils.Avatar $user 32}}
				<span><strong>{{$user.Name}}</strong><small>{{$user.DisplayName}}</small></span>
			</a>
			<a class="github-home-sidebar-icon" href="{{AppSubUrl}}/user/settings" title="{{ctx.Locale.Tr "settings"}}">{{svg "octicon-gear" 16}}</a>
			<a class="github-home-sidebar-icon" href="{{AppSubUrl}}/user/settings/appearance" title="{{ctx.Locale.Tr "settings.appearance"}}">{{svg "octicon-sun" 16}}</a>
		</div>
	</aside>
	<div class="theme-sidebar-main github-home-main">
		<header class="github-home-topbar">
			<form class="github-home-search" action="{{AppSubUrl}}/explore/repos" method="get" role="search">
				{{template "components/common/search/search" dict "Kind" "icon" "Placeholder" "Search or jump to..." "Shortcut" "/" "Class" "github-home-search-field"}}
			</form>
			<div class="github-home-topbar-actions">
				<a class="github-home-icon-button" href="{{AppSubUrl}}/repo/create" data-tooltip-content="{{ctx.Locale.Tr "create_new"}}">{{svg "octicon-plus" 16}}</a>
				{{if not .UnitIssuesGlobalDisabled}}<a class="github-home-icon-button" href="{{$base}}/issues{{$teamPath}}" data-tooltip-content="{{ctx.Locale.Tr "issues"}}">{{svg "octicon-issue-opened" 16}}</a>{{end}}
				{{if not .UnitPullsGlobalDisabled}}<a class="github-home-icon-button" href="{{$base}}/pulls{{$teamPath}}" data-tooltip-content="{{ctx.Locale.Tr "pull_requests"}}">{{svg "octicon-git-pull-request" 16}}</a>{{end}}
				<a class="github-home-icon-button" href="{{AppSubUrl}}/notifications" data-tooltip-content="{{ctx.Locale.Tr "notifications"}}">{{svg "octicon-inbox" 16}}</a>
				<a class="github-home-avatar" href="{{$user.HomeLink}}" aria-label="{{$user.Name}}">{{ctx.AvatarUtils.Avatar $user 28}}</a>
			</div>
		</header>
		<main class="github-home-content">
			<header class="github-home-welcome">
				<div>
					{{if $isOrg}}
						<h1>{{$user.DisplayName}}</h1>
					{{else}}
						<h1 data-theme-greeting data-name="{{$displayName}}">Hello, {{$displayName}}! 👋</h1>
					{{end}}
					<p>Here's what's happening with your work today.</p>
				</div>
				<a class="button theme-control github-home-customize" href="{{AppSubUrl}}/user/settings">{{svg "octicon-sliders" 16}} Customize Home</a>
			</header>
			<div class="github-home-grid">
				<div class="github-home-primary">
					<section class="github-home-section">
						<h2 class="github-home-section-title">Start writing code</h2>
						<div class="github-home-start-card">
							<div class="github-home-start-create">
								<div class="github-home-start-heading">{{svg "octicon-repo" 16}}<h3>Create a new repository</h3></div>
								<p>A repository contains all of your project's files, revision history, and collaborator discussion.</p>
								<form class="github-home-create-form" method="post" action="{{AppSubUrl}}/repo/create">
									<input type="hidden" name="uid" value="{{$user.ID}}">
									<div class="github-home-create-row">
										<span class="github-home-create-owner">{{ctx.AvatarUtils.Avatar $user 20}}{{$user.ShortName 40}} /</span>
										<input class="github-home-create-name" name="repo_name" placeholder="new-repo-name" required maxlength="100" autocomplete="off" autocapitalize="none" spellcheck="false">
										<select class="github-home-create-visibility" name="private" aria-label="Visibility">
											<option value="false">Public</option>
											<option value="true">Private</option>
										</select>
									</div>
									<button class="ui primary button theme-control" type="submit">Create repository</button>
								</form>
							</div>
							<ul class="github-home-start-actions">
								<li><a href="{{AppSubUrl}}/repo/migrate">{{svg "octicon-repo-clone" 16}}<span>Clone a repository</span>{{svg "octicon-chevron-right" 16}}</a></li>
								<li><a href="{{AppSubUrl}}/repo/create">{{svg "octicon-repo-template" 16}}<span>New from a template</span>{{svg "octicon-chevron-right" 16}}</a></li>
								<li><a href="{{AppSubUrl}}/repo/migrate">{{svg "octicon-repo-push" 16}}<span>Import a repository</span>{{svg "octicon-chevron-right" 16}}</a></li>
								<li><a href="{{AppSubUrl}}/explore/repos">{{svg "octicon-telescope" 16}}<span>Explore repositories</span>{{svg "octicon-chevron-right" 16}}</a></li>
							</ul>
						</div>
					</section>
					<section class="github-home-section">
						<div class="github-home-section-heading">
							<h2 class="github-home-section-title">Recent activity</h2>
							<a class="github-home-section-link" href="{{.Link}}">View all</a>
						</div>
						<div class="theme-box-list github-home-activity">
							{{if .Feeds}}
								{{template "components/dashboard/feed/feed" .}}
							{{else}}
								{{template "user/dashboard/guide" .}}
							{{end}}
						</div>
					</section>
					<section class="github-home-section">
						<div class="github-home-section-heading">
							<h2 class="github-home-section-title">Recommended for you</h2>
							<a class="github-home-section-link" href="{{AppSubUrl}}/explore/repos">See more</a>
						</div>
						<div class="github-home-recommended">
							{{if .DashboardRecommendedRepos}}
								{{range .DashboardRecommendedRepos}}
									<a class="github-home-repo-card" href="{{.Link}}">
										<div class="github-home-repo-card-title">{{svg "octicon-repo" 16}}<strong>{{.OwnerName}}/{{.Name}}</strong></div>
										<p>{{if .Description}}{{.Description}}{{else}}No description provided.{{end}}</p>
										<div class="github-home-repo-card-meta">
											{{if .PrimaryLanguage}}<span><i class="color-icon" style="background-color: {{.PrimaryLanguage.Color}}"></i>{{.PrimaryLanguage.Language}}</span>{{end}}
											{{if .NumStars}}<span>{{svg "octicon-star" 16}}{{CountFmt .NumStars}}</span>{{end}}
										</div>
									</a>
								{{end}}
							{{else}}
								<a class="github-home-repo-card" href="{{AppSubUrl}}/repo/create">
									<div class="github-home-repo-card-title">{{svg "octicon-repo" 16}}<strong>Create a repository</strong></div>
									<p>Start a new project and keep its files, history and collaboration in one place.</p>
								</a>
								<a class="github-home-repo-card" href="{{AppSubUrl}}/repo/migrate">
									<div class="github-home-repo-card-title">{{svg "octicon-repo-push" 16}}<strong>Import a repository</strong></div>
									<p>Bring an existing project from another host into NovroForge.</p>
								</a>
								<a class="github-home-repo-card" href="{{AppSubUrl}}/explore/repos">
									<div class="github-home-repo-card-title">{{svg "octicon-telescope" 16}}<strong>Explore repositories</strong></div>
									<p>Discover public projects and find something to contribute to.</p>
								</a>
							{{end}}
						</div>
					</section>
				</div>
				<aside class="github-home-secondary">
					<section class="github-home-side-card">
						<h2>Latest changes</h2>
						<ol class="github-home-changes">
							<li><span class="github-home-change-time">2h</span><div><a href="https://github.com/lux-zero-161/novroforge/commits/main">GitHub theme is now available</a><span class="github-home-badge">Beta</span></div></li>
							<li><span class="github-home-change-time">5h</span><div><a href="https://github.com/lux-zero-161/novroforge/commits/main">Dark dashboard is live</a></div></li>
							<li><span class="github-home-change-time">1d</span><div><a href="https://github.com/lux-zero-161/novroforge/commits/main">Server deployment completed</a></div></li>
							<li><span class="github-home-change-time">2d</span><div><a href="https://github.com/lux-zero-161/novroforge/commits/main">NovroForge is online</a></div></li>
						</ol>
						<a class="github-home-card-link" href="https://github.com/lux-zero-161/novroforge/commits/main">View changelog</a>
					</section>
					<section class="github-home-side-card">
						<h2>Explore repositories</h2>
						{{range .DashboardExploreRepos}}
							<a class="github-home-explore-repo" href="{{.Link}}">
								{{svg "octicon-repo" 16}}
								<div>
									<strong>{{.OwnerName}}/{{.Name}}</strong>
									<p>{{if .Description}}{{.Description}}{{else}}No description provided.{{end}}</p>
									<span>
										{{if .PrimaryLanguage}}<i class="color-icon" style="background-color: {{.PrimaryLanguage.Color}}"></i>{{.PrimaryLanguage.Language}}{{end}}
										{{if .NumStars}}{{svg "octicon-star" 12}}{{CountFmt .NumStars}}{{end}}
									</span>
								</div>
							</a>
						{{else}}
							<p class="github-home-empty">No public repositories yet.</p>
						{{end}}
						<a class="github-home-card-link" href="{{AppSubUrl}}/explore/repos">Explore more</a>
					</section>
					<section class="github-home-side-card">
						<h2>Your projects</h2>
						{{range .DashboardProjects}}
							<a class="github-home-project-row" href="{{.Link}}">
								<span class="github-home-project-name">{{svg "octicon-project" 16}}{{.Title}}</span>
								<span class="github-home-project-progress"><span style="width: {{.Progress}}%"></span></span>
								<span class="github-home-project-percent">{{.Progress}}%</span>
							</a>
						{{else}}
							<p class="github-home-empty">No projects yet.</p>
						{{end}}
						<a class="github-home-card-link" href="{{$user.HomeLink}}/-/projects">View all projects</a>
					</section>
				</aside>
			</div>
		</main>
	</div>
</div>
<script src="{{AssetUrlPrefix}}/js/dashboard-greeting.js?v=112ffc9736"></script>
{{template "base/footer" .}}
